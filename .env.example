# Required only for real Groq calls; offline tests need neither variable.
# Set your own key in the environment or an untracked .env file.
GROQ_API_KEY=

# Choose a currently supported Groq chat model with local tool calling:
# https://console.groq.com/docs/models
# https://console.groq.com/docs/tool-use/overview
# No model identifier is selected automatically.
JALWATCH_LLM_MODEL=

# Optional local Ollama model used only when context compaction is triggered.
JALWATCH_SUMMARY_MODEL=

# Optional relative or absolute SQLite checkpoint path.
JALWATCH_CHECKPOINT_DB=

# Optional Langfuse v4/OpenTelemetry export. Leave blank to disable telemetry.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Task 9 evaluation: choose a currently supported Groq structured-output model.
JALWATCH_JUDGE_MODEL=

# HTTP deployment. Keep JALWATCH_API_KEY distinct from Groq and approval HMAC.
# Defaults to true. Set false only for a public assignment demo.
JALWATCH_AUTH_REQUIRED=true
JALWATCH_API_KEY=
JALWATCH_ENVIRONMENT=local
JALWATCH_MCP_TRANSPORT=http
JALWATCH_MCP_URL=
# Exact public hostname only (no scheme/wildcard); Render hostname is auto-detected.
JALWATCH_PUBLIC_HOST=
# groq for deployed compaction; ollama for Task 7 local offline demonstration.
JALWATCH_SUMMARY_BACKEND=groq
JALWATCH_PERSISTENT_DISK=0

# The application does not load .env automatically. For manual smoke checks:
# uv run --env-file .env python -m jalwatch.llm.smoke --case both
