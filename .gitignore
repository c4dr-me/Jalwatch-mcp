# Environments and workspace-local tooling
.venv/
.tools/

# Python and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, type, lint and coverage caches
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local secrets (keep the documented template)
.env
.env.*
!.env.example
.envrc
.direnv/
*.pem
*.p12
*.pfx
*.key

# Runtime SQLite files, including journals and WAL sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local data is runtime-only; keep the directory marker.
data/*
!data/.gitkeep

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
Microsoft/
*.log
logs/
telemetry-export/
